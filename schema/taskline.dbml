// Taskline data model. apps/api/src/schema.sql mirrors it.

Enum task_status {
  todo
  in_progress
  done
}

Enum task_priority {
  low
  medium
  high
  urgent
}

Enum subscription_status {
  incomplete
  trialing
  active
  past_due
  canceled
}

Enum plan {
  free
  pro
}

Enum member_role {
  owner
  admin
  member
  viewer
}

Table projects {
  id uuid [pk]
  name varchar(120) [not null]
  slug varchar(140) [not null, unique]
  description varchar(500) [not null, default: '']
  color varchar(20) [not null, default: 'violet']
  created_at timestamp [not null, default: `now()`]
}

Table members {
  id uuid [pk]
  name varchar(120) [not null]
  email varchar(200) [not null, unique]
  role member_role [not null, default: 'member']
  avatar_color varchar(20) [not null, default: 'stone']
  created_at timestamp [not null, default: `now()`]
}

Table tasks {
  id uuid [pk]
  project_id uuid [not null]
  title varchar(200) [not null]
  description text [not null, default: '']
  status task_status [not null, default: 'todo']
  priority task_priority [not null, default: 'medium']
  assignee_id uuid
  due_date date
  position int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, status) [name: 'idx_tasks_project_status']
    assignee_id
    due_date
  }
}

Table comments {
  id uuid [pk]
  task_id uuid [not null]
  author_id uuid
  body text [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (task_id, created_at)
  }
}

Table activity {
  id uuid [pk]
  project_id uuid [not null]
  task_id uuid
  actor_id uuid
  action varchar(80) [not null]
  detail varchar(500) [not null, default: '']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, created_at)
  }
}

Table subscriptions {
  id uuid [pk]
  project_id uuid [not null, unique]
  stripe_customer_id varchar(64) [not null]
  stripe_subscription_id varchar(64) [unique]
  plan plan [not null, default: 'free']
  status subscription_status [not null, default: 'incomplete']
  current_period_end timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table invites {
  id uuid [pk]
  project_id uuid [not null]
  email varchar(200) [not null]
  role member_role [not null, default: 'member']
  invited_by uuid
  accepted_member_id uuid
  expires_at timestamp [not null]
  accepted_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, created_at)
  }
}

Ref: tasks.project_id > projects.id [delete: cascade]
Ref: tasks.assignee_id > members.id [delete: set null]
Ref: comments.task_id > tasks.id [delete: cascade]
Ref: comments.author_id > members.id [delete: set null]
Ref: activity.project_id > projects.id [delete: cascade]
Ref: activity.task_id > tasks.id [delete: set null]
Ref: activity.actor_id > members.id [delete: set null]
Ref: subscriptions.project_id - projects.id [delete: cascade]
Ref: invites.project_id > projects.id [delete: cascade]
Ref: invites.invited_by > members.id [delete: set null]
Ref: invites.accepted_member_id > members.id [delete: set null]
